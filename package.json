{
  "name": "xroster",
  "version": "0.1.0",
  "private": true,
  "description": "xRoster — War Room de agentes operativos xIPTV (Jarvis, Sentinel, Tank, Shikamaru). REQ-2026-012 / RFC-2026-003.",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs test",
    "test:sql": "node scripts/run-tests.mjs test/sql"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
