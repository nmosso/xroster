# ============================================================
# xRoster — Variables de entorno (REQ-2026-012 §5.3)
# Copiar a ../.env.roster (un nivel arriba del repo, fuera de git):
#   cp .env.example ../.env.roster
# Así `git pull` nunca lo sobrescribe. Ruta alternativa: XROSTER_ENV_FILE=/ruta/al/archivo
# Todo el comportamiento es portable a VM dedicada solo cambiando ese archivo.
# ============================================================

# --- HTTP & Seguridad ---
PORT=3900
XROSTER_WEBHOOK_SECRET=change-me-long-random-secret
# JID del grupo War Room (único destino permitido de salida)
WHATSAPP_COMMAND_GROUP_ID=120363000000000000@g.us
# CSV de teléfonos E.164 autorizados (se normalizan 54 -> 549 igual que xBackend)
OWNER_WHATSAPP_PHONES=5491100000000

# --- Evolution API v2 ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE_NAME=xiptv

# --- Fuentes del ecosistema ---
# Pool lectura/escritura hacia la BD dedicada xrosterdb
PG_XROSTER_URL=postgres://xroster_user:change-me@postgres-xserver:5432/xrosterdb
# Pool estrictamente READ-ONLY hacia public.tenants de xBackend
PG_XSERVER_RO_URL=postgres://xroster_ro:change-me@postgres-xserver:5432/xserver
REDIS_URL=redis://redis:6379
SSH_KEY_PATH=/run/secrets/ssh_key
SSH_USER=root
SSH_TIMEOUT_MS=8000

# --- Git / Shikamaru ---
XPLANNING_REPO_URL=https://github.com/nmosso/xPlanning.git
XPLANNING_BRANCH=main
# Opcional: token con permiso de push solo para ramas draft/*
XPLANNING_GIT_TOKEN=
XPLANNING_LOCAL_DIR=/data/xPlanning

# --- Motores IA ---
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
# cli = invoca `claude -p` (plan Claude Code) | api = Anthropic Messages API
CLAUDE_PROVIDER=cli
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- Sentinel ---
SENTINEL_POLL_MS=60000
SENTINEL_ALERT_COOLDOWN_MS=1800000
SENTINEL_STORM_THRESHOLD=3
# Todo se monitorea y persiste en sentinel_alert_state (cpanel-roster / "¿qué está caído?").
# Estas variables solo filtran el push proactivo al War Room de WhatsApp.
# CSV de componentes que notifican: proxmox,xmanager,multicast,streamer,ird
SENTINEL_NOTIFY_COMPONENTS=proxmox
# true = recordatorio "🔁 Sigue…" cada SENTINEL_ALERT_COOLDOWN_MS; false = solo nuevo, cambio de severidad y RECUPERADO
SENTINEL_NOTIFY_REMINDERS=false
# Gracia antes del primer aviso (micro-cortes recuperados dentro de la gracia no envían nada)
# VM = proxmox, xmanager, multicast, streamer (2 min) · IRD (10 min)
SENTINEL_VM_GRACE_MS=120000
SENTINEL_IRD_GRACE_MS=600000

# --- cpanel-roster (Web UI — https://roster.xisrv.xyz · REQ-2026-013) ---
# Fail-closed: sin ROSTER_WEB_PASSWORD o ROSTER_SESSION_SECRET, /api/* responde 503.
ROSTER_WEB_USER=admin
ROSTER_WEB_PASSWORD=change-me-strong-password
# Generar con: openssl rand -hex 32
ROSTER_SESSION_SECRET=change-me-64-char-random-hex
# Cookie `Secure` (HTTPS). Default: true si NODE_ENV=production; usar false solo en desarrollo local por HTTP.
ROSTER_COOKIE_SECURE=true

# --- Opcionales (fuera de §5.3) ---
# Override de unidades systemd del catálogo L1 de Tank (solo xmanager|multicast|streamer)
# TANK_SERVICE_UNITS=streamer=streamer,multicast=multicast,xmanager=xmanager
# docker-compose: IP de bind del puerto y ruta host de la clave SSH
# XROSTER_BIND_ADDR=127.0.0.1
# SSH_KEY_HOST_PATH=./secrets/ssh_key
